# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# 依赖
node_modules/

# 根目录的 package-lock 不需要（网页版本体零依赖，没有 npm 包）
/package-lock.json

# 构建产物
dist/
build/
*.log

# 桌面版构建产物（renderer 由 scripts/sync-renderer.mjs 从上级目录生成，不入库）
desktop/renderer/
desktop/dist/
desktop/dist-release*/
desktop/.verify-data/

# 本地测试与临时文件
.qa-tmp/
*.tmp
*.bak

# 导出的数据（含图片，体积大且属于个人数据）
*.promptvault.json
export-*.json
export-*.csv
